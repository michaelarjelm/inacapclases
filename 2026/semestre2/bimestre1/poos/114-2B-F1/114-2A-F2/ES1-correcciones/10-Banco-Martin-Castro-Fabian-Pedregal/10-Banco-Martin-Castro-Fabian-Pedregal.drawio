        <mxCell id="e17_lbl" value="registra operaciones" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#4C5761;align=center;verticalAlign=middle;connectable=0;" vertex="1" connectable="0" parent="e17">
          <mxGeometry relative="1" x="0.0" as="geometry">
