        <!-- ===================== NOTAS DE CORRECCION ===================== -->

        <mxCell id="note1" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;La ficha pedia que los movimientos del periodo&lt;br&gt;(depositos, giros, cargos) quedaran como detalle de la&lt;br&gt;cuenta. Lo que se modelo (Credito-CuotaCredito) es otra&lt;br&gt;cosa. Se agrego MovimientoCuenta: Cajero.registrarDeposito()&lt;br&gt;y registrarRetiro() ahora tienen donde quedar registrados." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="800" y="560" width="320" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;CuentaBloqueadaException resolvia un caso distinto (cuenta&lt;br&gt;inactiva). La segunda regla de bloqueo de la ficha era no&lt;br&gt;abrir cuenta a un cliente con mora vigente: se agrego&lt;br&gt;MoraVigenteException y el metodo Ejecutivo.abrirCuenta(),&lt;br&gt;que la ficha menciona pero no estaba en el diagrama." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1500" y="700" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Ejecutivo-Cliente, Ejecutivo-Credito y Cajero-Cuenta&lt;br&gt;estaban etiquetadas como asociacion, categoria que el&lt;br&gt;curso elimino antes de la ES1 (solo quedan herencia,&lt;br&gt;agregacion y composicion). Como ninguna clase guarda una&lt;br&gt;referencia permanente a la otra (se usan solo como&lt;br&gt;parametro), pasaron a dependencia -- mismo tipo de flecha&lt;br&gt;punteada que ya usaban para ServicioIndicadorUF." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="360" height="150" as="geometry" />
        </mxCell>

        <mxCell id="note4" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;En la vista general varios atributos no tenian tipo y&lt;br&gt;varios metodos no tenian retorno declarado. Se completaron&lt;br&gt;todos. Tambien se agregaron los atributos de referencia&lt;br&gt;que faltaban para que cada relacion dibujada exista como&lt;br&gt;codigo: Cliente.cuentas, Cliente.creditos, Cuenta.movimientos&lt;br&gt;y Credito.cuotas." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="420" y="1000" width="360" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
