<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Banco Cooperativo Andino - Modelo corregido" id="banco-model">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titulo -->
        <mxCell id="title" value="Banco Cooperativo Andino - ES1 TI3V21 114-2B-F1 - Modelo de clases (version corregida)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Equipo: Yanet Valdes y Dayana Reyes&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="-60" width="1000" height="45" as="geometry" />
        </mxCell>

        <mxCell id="changelog" value="Cambios respecto a la entrega original: (1) se agrego MovimientoCuenta (composicion desde Cuenta) para modelar la cartola -- depositos, giros y cargos como detalle de la cuenta, en vez de confundirla con Credito-CuotaCredito; (2) se agrego MoraVigenteException y el metodo Ejecutivo.abrirCuenta(), que la ficha menciona pero no estaba dibujado, para la regla de no abrir cuenta a cliente con mora vigente; (3) Ejecutivo-Cliente, Ejecutivo-Credito y Cajero-Cuenta pasaron de asociacion (categoria eliminada del curso) a dependencia, porque ninguna clase guarda una referencia permanente a la otra -- interactuan solo como parametro de metodo; (4) tipos de dato y retornos completados en todos los atributos y metodos; (5) se agregaron los atributos de referencia que faltaban (Cliente.cuentas, Cliente.creditos, Cuenta.movimientos, Credito.cuotas)." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#4C5761;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="-12" width="1780" height="44" as="geometry" />
        </mxCell>

