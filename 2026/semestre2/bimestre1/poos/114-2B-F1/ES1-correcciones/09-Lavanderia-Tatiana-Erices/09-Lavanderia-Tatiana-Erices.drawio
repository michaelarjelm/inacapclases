        <mxCell id="e12_lbl" value="consulta valor dolar" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#4C5761;align=center;verticalAlign=middle;connectable=0;" vertex="1" connectable="0" parent="e12">
          <mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-12" as="offset" /></mxGeometry>
        </mxCell>


        <!-- ===================== NOTAS DE CORRECCION ===================== -->

        <mxCell id="note1" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;ProductoQuimico solo se conectaba con CotizacionDolar: no&lt;br&gt;quedaba claro como su costo llegaba a la Orden. Se agrego&lt;br&gt;Prenda.productoQuimico (para prendas con lavado en&lt;br&gt;seco), conectando la cadena completa hasta el subtotal&lt;br&gt;de DetalleOrden." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1420" y="620" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;CotizacionDolar-ProductoQuimico estaba dibujada como&lt;br&gt;agregacion. calcularPrecioPesos(valorDolar) recibe el&lt;br&gt;valor como parametro: ProductoQuimico no guarda una&lt;br&gt;referencia permanente a CotizacionDolar, solo la consulta.&lt;br&gt;Paso a dependencia." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1060" y="620" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;DetalleOrden-Prenda 1 a 1 dejaba a DetalleOrden casi&lt;br&gt;redundante (solo aportaba el subtotal). Se agrego&lt;br&gt;DetalleOrden.cantidad, igual que en toda otra&lt;br&gt;transaccion con lineas de detalle del curso." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="note4" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Se agregaron los atributos de referencia que faltaban:&lt;br&gt;Orden.cliente, Orden.cajero, Orden.detalles y&lt;br&gt;Operario.maquinasAsignadas, para que las relaciones&lt;br&gt;dibujadas existan como codigo." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="330" height="110" as="geometry" />
        </mxCell>

      </root>
