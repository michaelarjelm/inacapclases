        <!-- ===================== NOTAS DE CORRECCION ===================== -->

        <mxCell id="note1" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Cliente-Reserva, Paquete-Reserva y DetalleReserva-&lt;br&gt;ServicioTuristico estaban etiquetadas como composicion.&lt;br&gt;Ninguna es de pertenencia exclusiva (un cliente sigue&lt;br&gt;existiendo sin sus reservas, un servicio turistico no es&lt;br&gt;parte de un detalle). Pasaron a agregacion." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1900" y="450" width="320" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Tipo_Cambio-Paquete se dibujo como agregacion (rombo&lt;br&gt;blanco). Un paquete no posee un tipo de cambio: lo&lt;br&gt;consulta para convertir su precio. Paso a dependencia,&lt;br&gt;igual que las demas consultas de indicadores externos&lt;br&gt;del curso." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1000" y="650" width="320" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Cliente repetia rut y nombre, y Empleado repetia rut y&lt;br&gt;nombre tambien -- ambos ya declarados en Persona. Se&lt;br&gt;quitaron: contradecian el propio argumento del informe&lt;br&gt;para usar herencia (evitar duplicar atributos comunes)." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="note4" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Nomenclatura mezclada en la entrega original (casi todo&lt;br&gt;en MAYUSCULAS_CON_GUION, salvo Persona y&lt;br&gt;servicio_turistico en minuscula) y sin el signo &amp;quot;-&amp;quot; de&lt;br&gt;visibilidad en ningun atributo. Unificado a&lt;br&gt;PascalCase/camelCase con visibilidad completa en&lt;br&gt;todas las clases." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="650" width="340" height="140" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
