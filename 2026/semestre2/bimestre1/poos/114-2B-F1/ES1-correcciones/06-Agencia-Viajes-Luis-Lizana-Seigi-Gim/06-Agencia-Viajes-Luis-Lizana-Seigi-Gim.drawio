        <!-- Titulo -->
        <mxCell id="title" value="Agencia de Viajes RutaSur - ES1 TI3V21 114-2B-F1 - Modelo de clases (version corregida)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Equipo: Luis Lizana y Seigi Gim&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="-60" width="1000" height="45" as="geometry" />
        </mxCell>

        <mxCell id="changelog" value="Cambios respecto a la entrega original: (1) se agrego el signo &amp;quot;-&amp;quot; de visibilidad a todos los atributos (aparecian sin el); (2) nomenclatura unificada a PascalCase/camelCase en toda la clase, metodo y atributo (la entrega mezclaba MAYUSCULAS_CON_GUION con Persona y servicio_turistico en minuscula); (3) Cliente-Reserva, Paquete-Reserva y DetalleReserva-ServicioTuristico pasaron de composicion (mal etiquetada) a agregacion; (4) Tipo_Cambio-Paquete paso de agregacion (mal etiquetada, rombo blanco) a dependencia; (5) se quitaron de Cliente y Empleado los atributos rut, nombre y movil, que ya estan en Persona y contradecian el propio argumento de herencia del informe; (6) se agregaron los atributos de referencia que faltaban en Reserva, DetalleReserva, Pago y ServicioTuristico." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#4C5761;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="-14" width="3230" height="50" as="geometry" />
        </mxCell>

