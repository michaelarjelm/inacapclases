        <!-- ===================== NOTAS DE CORRECCION ===================== -->

        <mxCell id="note1" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;El informe decia que Matricula-DetalleMatricula era&lt;br&gt;composicion, pero el diagrama dibujaba rombo hueco&lt;br&gt;(agregacion). Una linea de detalle no existe sin su&lt;br&gt;cabecera: corresponde rombo relleno." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="2100" y="700" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;La relacion &amp;quot;1/0..*&amp;quot; de matricula salia de Persona,&lt;br&gt;no de Estudiante. Eso permitiria que un Empleado tuviera&lt;br&gt;matriculas. La justificacion escrita ya decia&lt;br&gt;&amp;quot;Estudiante-Matricula&amp;quot;: se reconecto para que calce." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Evaluacion tenia un atributo periodoAbierto: boolean&lt;br&gt;suelto, que podia quedar desincronizado del estado real&lt;br&gt;del periodo. Se reemplazo por una referencia&lt;br&gt;periodoAcademico: PeriodoAcademico -- editarNota() debe&lt;br&gt;preguntar periodoAcademico.estaAbierto(), no confiar en&lt;br&gt;una copia local." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="400" y="700" width="360" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note4" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Arancel-Matricula e IndicadorUF-Matricula estaban&lt;br&gt;dibujadas con multiplicidad numerica (una sola etiqueta&lt;br&gt;al medio de la linea, sin separar los dos extremos).&lt;br&gt;Matricula no posee un Arancel ni un IndicadorUF: los&lt;br&gt;consulta para calcular el cobro y guarda el resultado en&lt;br&gt;valorUFAplicado. Pasaron a dependencia, sin multiplicidad,&lt;br&gt;igual que las demas consultas del curso." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="800" y="700" width="360" height="150" as="geometry" />
        </mxCell>

        <mxCell id="note5" value="&lt;b&gt;NO CORREGIDO EN EL DIAGRAMA&lt;/b&gt;&lt;br&gt;El informe describe la clase Profesor con los atributos y&lt;br&gt;metodos de Evaluacion (fecha, nota, calcularPromedio(),&lt;br&gt;etc). En el diagrama esto SI esta bien separado -- es un&lt;br&gt;error del texto del informe, no del modelo, asi que no&lt;br&gt;requiere cambio aqui." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#38658C;fontSize=11;strokeColor=#38658C;fillColor=#E2EBF2;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1200" y="700" width="270" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
