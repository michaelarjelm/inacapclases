        <!-- Titulo -->
        <mxCell id="title" value="Colegio Nueva Esperanza - ES1 TI3V21 114-2B-F1 - Modelo de clases (version corregida)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Equipo: Debora Toledo y Mariana Puglicivich&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="-60" width="1000" height="45" as="geometry" />
        </mxCell>

        <mxCell id="changelog" value="Cambios respecto a la entrega original: (1) Matricula-DetalleMatricula pasa de agregacion (rombo hueco) a composicion (rombo relleno), como ya decia el informe; (2) la relacion de matricula se reconecto de Persona a Estudiante -- solo estudiantes se matriculan; (3) Evaluacion.periodoAbierto (booleano suelto) se reemplazo por una referencia real a PeriodoAcademico; (4) Arancel e IndicadorUF pasan de relacion numerada a dependencia (Matricula los consulta, no los posee) -- resuelve las multiplicidades mal ubicadas; (5) se agregaron los atributos de referencia que faltaban en Estudiante, Evaluacion, Matricula y DetalleMatricula; (6) tipos y retornos completados en todos los metodos." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#4C5761;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="-14" width="1690" height="46" as="geometry" />
        </mxCell>

