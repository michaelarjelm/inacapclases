<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Hotel Los Alerces - Modelo corregido" id="hotel-model">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3450" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titulo -->
        <mxCell id="title" value="Hotel Boutique Los Alerces - ES1 TI3V21 114-2B-F1 - Modelo de clases (version corregida y simplificada)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Autor: Kevin Rivera&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="-60" width="1100" height="45" as="geometry" />
        </mxCell>

        <mxCell id="changelog" value="Cambios respecto a la entrega original: (1) se elimino la clase Estadia -- sus datos (fechaCheckInReal, fechaCheckOutReal) y su relacion con Consumo se plegaron directamente en Reserva, que ya tenia un estado EstadoReserva con CHECK_IN/CHECK_OUT propios; queda una sola transaccion con lineas de detalle (DetalleReserva y Consumo) en vez de tres estructuras paralelas; (2) TipoHabitacion e IndicadorExterno (mencionados en el informe pero ausentes del diagrama) se eliminaron del texto: el diagrama real usa IndicadorDolar directamente sobre Habitacion, sin una clase de tipo intermedia; (3) se agregaron los atributos de referencia que faltaban en casi todas las relaciones; (4) calcularCapacidad()/obtenerDescripcion() se promovieron a Habitacion para que exista un metodo comun que los tres subtipos sobrescriben." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#4C5761;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="-14" width="3380" height="50" as="geometry" />
        </mxCell>

