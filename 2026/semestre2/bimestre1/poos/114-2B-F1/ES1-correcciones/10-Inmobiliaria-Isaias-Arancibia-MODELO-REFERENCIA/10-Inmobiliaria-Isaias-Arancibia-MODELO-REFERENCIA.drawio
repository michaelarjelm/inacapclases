        <!-- Titulo -->
        <mxCell id="title" value="Inmobiliaria Terrenos del Sur - ES1 TI3V21 114-2B-F1 - Modelo de referencia&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Autor: Isaias Arancibia&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="-60" width="1000" height="45" as="geometry" />
        </mxCell>

        <mxCell id="changelog" value="Este NO es una correccion sobre el trabajo entregado: la entrega original no tenia un modelo real que corregir (un diagrama minimo de 4 clases sin ningun requisito minimo cubierto, mas 21 paginas de diagramas entidad-relacion de otros negocios, ajenos al encargo). Este archivo se construyo desde cero a partir de la ficha oficial de Inmobiliaria Terrenos del Sur (Fichas_14_Negocios.md), como modelo de referencia de lo que se esperaba, cubriendo los seis requisitos minimos: 3 subtipos de Propiedad, 2 tipos de trabajador (Corredor/Administrador), validacion de RUT, Contrato con DetalleContrato, 2 reglas de bloqueo (disponibilidad y mora) y precio segun UF." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#4C5761;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="-16" width="2430" height="54" as="geometry" />
        </mxCell>

