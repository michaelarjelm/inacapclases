        <!-- ===================== NOTAS ===================== -->

        <mxCell id="note1" value="&lt;b&gt;SEIS REQUISITOS MINIMOS CUBIERTOS&lt;/b&gt;&lt;br&gt;1. Tres subtipos con comportamiento distinto: Casa,&lt;br&gt;Departamento y Oficina sobrescriben calcularArriendo().&lt;br&gt;2. Dos trabajadores con permisos distintos: Corredor&lt;br&gt;(negocia con clientes) y Administrador (publica y gestiona&lt;br&gt;pagos, no negocia).&lt;br&gt;3. Dato validado: Persona.validarRut(), antes de firmar.&lt;br&gt;4. Transaccion con detalle: Contrato compone&lt;br&gt;DetalleContrato (arriendo, gastos comunes, garantia).&lt;br&gt;5. Dos reglas de bloqueo: Contrato.validarDisponibilidad()&lt;br&gt;y Contrato.validarMoraCliente().&lt;br&gt;6. Precio por indicador externo: Propiedad.valorUF&lt;br&gt;convertido a pesos via IndicadorUF, actualizado a diario." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#2F6B4F;fontSize=11;strokeColor=#2F6B4F;fillColor=#E3EFE7;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="360" height="280" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;POR QUE ES UN MODELO NUEVO, NO UNA CORRECCION&lt;/b&gt;&lt;br&gt;La entrega original solo traia, en su primera pagina, un&lt;br&gt;diagrama minimo con Agente, Propiedad, Cliente y Venta,&lt;br&gt;sin tipos de dato, sin herencia ni composicion, y sin&lt;br&gt;ninguno de los seis requisitos. Las paginas 3 a 22 eran&lt;br&gt;diagramas entidad-relacion de otros negocios (hospital,&lt;br&gt;tienda, paqueteria, automotora, futbol, agencia de viajes,&lt;br&gt;academia). No habia base real para corregir: este archivo&lt;br&gt;muestra como se veria un modelo completo para el negocio&lt;br&gt;asignado, tomando la ficha oficial como fuente." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="440" y="620" width="380" height="280" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
