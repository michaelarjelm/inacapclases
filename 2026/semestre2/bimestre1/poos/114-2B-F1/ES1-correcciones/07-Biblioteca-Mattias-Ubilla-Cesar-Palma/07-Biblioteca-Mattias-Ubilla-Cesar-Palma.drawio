  <diagram name="Página-1" id="IscWPvmdSkQKw2GWKTId">
    <mxGraphModel dx="1768" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4681" pageHeight="3300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% ENUMERACIONES (Representadas mediante estereotipos)\n    class EstadoMaterial {\n        &lt;&lt;enumeration&gt;&gt;\n        DISPONIBLE\n        PRESTADO\n        EXTRAVIADO\n    }\n\n    class EstadoMulta {\n        &lt;&lt;enumeration&gt;&gt;\n        PENDIENTE\n        PAGADA\n        CONDONADA\n    }\n\n    %% MATERIALES Y HERENCIA\n    class Material {\n        &lt;&lt;abstract&gt;&gt;\n        -String codigo\n        -String titulo\n        -EstadoMaterial estado\n        +getDiasPrestamo() int\n        +getMaxRenovaciones() int\n    }\n\n    class Libro {\n        -boolean esExtranjero\n        -float valorReposicionDolares\n        -float valorReposicionPesos\n        +getDiasPrestamo() int\n        +getMaxRenovaciones() int\n        +calcularValorReposicion(float valorDolarDia) float\n    }\n\n    class Revista {\n        -int numeroEdicion\n        +getDiasPrestamo() int\n        +getMaxRenovaciones() int\n    }\n\n    class Multimedia {\n        -String formato\n        +getDiasPrestamo() int\n        +getMaxRenovaciones() int\n    }\n\n    Libro --|&gt; Material\n    Revista --|&gt; Material\n    Multimedia --|&gt; Material\n\n    %% EMPLEADOS Y ROLES\n    class Empleado {\n        &lt;&lt;abstract&gt;&gt;\n        -String rut\n        -String nombre\n    }\n\n    class Bibliotecaria {\n        +registrarPrestamo(Socio socio, List items) void\n        +registrarDevolucion(DetallePrestamo detalle) void\n    }\n\n    class Administradora {\n        +darAltaMaterial(Material m) void\n        +eliminarMaterial(Material m) void\n        +condonarMulta(Multa m) void\n    }\n\n    Bibliotecaria --|&gt; Empleado\n    Administradora --|&gt; Empleado\n\n    %% SOCIOS Y MULTAS\n    class Socio {\n        -String rut\n        -String nombre\n        -String direccion\n        +validarRUT(String rut) boolean\n        +tieneMultaPendiente() boolean\n    }\n\n    class Multa {\n        -float monto\n        -EstadoMulta estado\n        +pagar()\n    }\n\n    Socio \&quot;1\&quot; --&gt; \&quot;*\&quot; Multa : posee\n\n    %% PRÉSTAMOS (CABECERA - DETALLE)\n    class Prestamo {\n        -int idPrestamo\n        -Date fechaRegistro\n        +registrarPrestamo()\n    }\n\n    class DetallePrestamo {\n        -Date fechaVencimiento\n        -int renovacionesUsadas\n        +renovar()\n        +marcarPerdido()\n    }\n\n    Prestamo \&quot;1\&quot; *-- \&quot;1..*\&quot; DetallePrestamo : contiene\n    DetallePrestamo \&quot;*\&quot; --&gt; \&quot;1\&quot; Material : asocia\n    Prestamo \&quot;*\&quot; --&gt; \&quot;1\&quot; Socio : asignado a\n    Prestamo \&quot;*\&quot; --&gt; \&quot;1\&quot; Empleado : registrado por&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_GJw1WQNRb_iidcETn6O-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
