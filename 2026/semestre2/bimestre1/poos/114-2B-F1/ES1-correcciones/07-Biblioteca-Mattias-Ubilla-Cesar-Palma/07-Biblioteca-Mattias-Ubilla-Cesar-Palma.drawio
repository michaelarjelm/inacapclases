        <!-- ===================== NOTAS DE CORRECCION (agregadas en revision) ===================== -->

        <mxCell id="corr-title" value="&lt;b&gt;Biblioteca Municipal Cordillera - version corregida&lt;/b&gt;&lt;br&gt;Equipo: Mattias Ubilla y Cesar Palma" style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="440" height="60" as="geometry" />
        </mxCell>

        <mxCell id="corr-note1" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Faltaba el tipo de retorno en los metodos de&lt;br&gt;Bibliotecaria (registrarPrestamo, registrarDevolucion)&lt;br&gt;y Administradora (darAltaMaterial, eliminarMaterial,&lt;br&gt;condonarMulta). Se agrego &amp;quot;: void&amp;quot; a los cinco, igual&lt;br&gt;que el resto del diagrama ya lo hacia." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=13;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="440" height="150" as="geometry" />
        </mxCell>

        <mxCell id="corr-note2" value="&lt;b&gt;NO SE TOCO&lt;/b&gt;&lt;br&gt;El feedback tambien menciona Prestamo.registrarPrestamo()&lt;br&gt;y Multa.pagar() como metodos sin retorno. En este archivo&lt;br&gt;registrarPrestamo() ya declara &amp;quot;: str&amp;quot; y el metodo real de&lt;br&gt;Multa se llama pagado(), con &amp;quot;: bool&amp;quot; ya declarado -- no&lt;br&gt;hay nada que corregir ahi, se dejaron intactos." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#38658C;fontSize=13;strokeColor=#38658C;fillColor=#E2EBF2;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="440" height="160" as="geometry" />
        </mxCell>

      </root>
