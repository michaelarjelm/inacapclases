        <!-- Titulo -->
        <mxCell id="title" value="Tienda e-commerce ClickAndGo - ES1 TI3V21 114-2B-F1 - Modelo de clases (version corregida)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Autor: Hector Guzman&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="-60" width="1000" height="45" as="geometry" />
        </mxCell>

        <mxCell id="changelog" value="Cambios respecto a la entrega original: (1) se agrego la clase Trabajador (abstracta, con el atributo nombre que EncargadoBodega y Administrador repetian) y ambas ahora heredan de ella; (2) EncargadoBodega y Administrador estaban sueltos, sin ninguna relacion con el resto del modelo: se agregaron dependencias hacia Pedido y Producto usando los mismos metodos que ya tenian; (3) Producto se marco como clase abstracta -- su metodo procesar_Entrega() se sobrescribe en los tres subtipos y nunca deberia instanciarse directamente; (4) se agregaron los atributos de referencia que faltaban en Cliente, Pedido y LineaPedido; (5) los atributos que estaban corridos en una sola linea por caja quedan uno por linea (arreglado por construccion al regenerar el diagrama)." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#4C5761;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="-14" width="1930" height="50" as="geometry" />
        </mxCell>

