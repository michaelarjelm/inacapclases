        <mxCell id="e10_lbl" value="prepara / despacha" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#4C5761;align=center;verticalAlign=middle;connectable=0;" vertex="1" connectable="0" parent="e10">
          <mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="e11" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;exitX=0.5;exitY=0;entryX=1;entryY=0.8;" edge="1" parent="1" source="administrador" target="producto">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1410" y="150" />
              <mxPoint x="300" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11_lbl" value="gestiona catalogo" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#4C5761;align=center;verticalAlign=middle;connectable=0;" vertex="1" connectable="0" parent="e11">
          <mxGeometry relative="1" x="0.0" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry>
        </mxCell>


        <!-- ===================== NOTAS DE CORRECCION ===================== -->

        <mxCell id="note1" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;EncargadoBodega y Administrador quedaban sueltos: sin&lt;br&gt;herencia de un trabajador comun ni relacion con Pedido o&lt;br&gt;Producto. Se agrego Trabajador (con el nombre que ambos&lt;br&gt;repetian) y dos dependencias hacia lo que ya operaban por&lt;br&gt;parametro en sus propios metodos." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="980" y="340" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Producto no estaba marcada como abstracta pese a que su&lt;br&gt;metodo procesar_Entrega() se sobrescribe en los tres&lt;br&gt;subtipos y nunca deberia instanciarse directamente." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Se agregaron los atributos de referencia que faltaban:&lt;br&gt;Cliente.pedidos, Pedido.lineas y LineaPedido.producto, para&lt;br&gt;que las relaciones dibujadas existan como codigo." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1620" y="750" width="300" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
