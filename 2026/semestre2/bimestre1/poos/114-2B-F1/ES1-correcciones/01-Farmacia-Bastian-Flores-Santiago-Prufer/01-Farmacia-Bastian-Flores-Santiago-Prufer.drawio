        <mxCell id="title" value="Farmacia Vecinal SaludYa - ES1 TI3V21 114-2B-F1 - Modelo de clases (version corregida)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Equipo: Bastian Flores y Santiago Prufer&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="-60" width="1000" height="45" as="geometry" />
        </mxCell>

        <mxCell id="changelog" value="Cambios respecto a la entrega original: (1) herencia de los tres subtipos de medicamento corregida (apuntaba a Receta, ahora apunta a Medicamento); (2) nomenclatura unificada (Medicamento en singular, Trabajador en vez de personal, QuimicoFarmaceutico sin guion bajo); (3) las asociaciones (categoria eliminada del curso) pasaron a agregacion: DetalleVenta-Medicamento, DetalleVenta-Receta, Venta-Cliente, Venta-Trabajador; (4) se agregaron los atributos de referencia que faltaban en Venta y DetalleVenta." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#4C5761;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="-14" width="1830" height="46" as="geometry" />
