        <mxCell id="e10" style="startArrow=diamondThin;startFill=1;endArrow=none;html=1;rounded=0;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="venta" target="detalleventa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10_sl" value="1" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;connectable=0;" vertex="1" connectable="0" parent="e10">
          <mxGeometry relative="1" x="-0.8" as="geometry"><mxPoint x="4" y="-16" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e10_tl" value="1..*" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;connectable=0;" vertex="1" connectable="0" parent="e10">
          <mxGeometry relative="1" x="0.8" as="geometry"><mxPoint x="-22" y="-16" as="offset" /></mxGeometry>
        </mxCell>


        <!-- ===================== NOTAS DE CORRECCION ===================== -->

        <mxCell id="note1" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;La herencia apuntaba a Receta en la entrega original: el&lt;br&gt;diagrama decia &amp;quot;un medicamento sin receta es un tipo&lt;br&gt;de receta&amp;quot;. Los tres subtipos ahora heredan de&lt;br&gt;Medicamento, que es donde vive validarVenta() a&lt;br&gt;sobrescribir." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1240" y="460" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Nomenclatura inconsistente en la entrega original:&lt;br&gt;Medicamentos en plural, personal en minuscula,&lt;br&gt;Quimico_farmaceutico con guion bajo. Unificado a&lt;br&gt;Medicamento, Trabajador y QuimicoFarmaceutico." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;El informe llamaba &amp;quot;asociacion&amp;quot; a DetalleVenta-&lt;br&gt;Medicamento, DetalleVenta-Receta, Venta-Cliente y Venta-&lt;br&gt;Trabajador -- categoria que el curso elimino antes de la&lt;br&gt;ES1. Pasaron a agregacion, y se agregaron los atributos&lt;br&gt;de referencia que faltaban (Venta.cliente, Venta.trabajador,&lt;br&gt;Venta.detalles, DetalleVenta.medicamento,&lt;br&gt;DetalleVenta.receta) para que existan como codigo." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="380" y="850" width="360" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
