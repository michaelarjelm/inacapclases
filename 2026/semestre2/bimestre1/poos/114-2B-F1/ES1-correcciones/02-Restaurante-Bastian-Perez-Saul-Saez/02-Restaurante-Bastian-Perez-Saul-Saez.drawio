        <!-- ===================== NOTAS DE CORRECCION ===================== -->

        <mxCell id="note1" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;La herencia de PlatoCaliente hacia ItemMenu, y las dos&lt;br&gt;relaciones que debian unir Pedido, DetallePedido e&lt;br&gt;ItemMenu, estaban dibujadas en el archivo original sin&lt;br&gt;source ni target: quedaban flotando, sin conectar a&lt;br&gt;ninguna clase real." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1120" y="700" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Mesero-Pedido y Pedido-Boleta estaban dibujadas con&lt;br&gt;rombo relleno (composicion). Ninguna de las dos es una&lt;br&gt;relacion de pertenencia exclusiva -- un pedido sigue&lt;br&gt;existiendo si cambia de mesero, y una boleta no es una&lt;br&gt;parte del pedido. Pasaron a agregacion (rombo hueco)." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1120" y="840" width="320" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note3" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;PlatoCaliente, Bebida y Postre sobrescribian tres&lt;br&gt;metodos con nombres distintos (PrecioPlatoCaliente,&lt;br&gt;PrecioBebida, PrecioPostre). Para que exista&lt;br&gt;polimorfismo real, los tres ahora sobrescriben el mismo&lt;br&gt;metodo calcularPrecio() declarado en ItemMenu." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1310" y="400" width="320" height="130" as="geometry" />
        </mxCell>

        <mxCell id="note4" value="&lt;b&gt;CORREGIDO&lt;/b&gt;&lt;br&gt;Las relaciones Pedido-Mesa, Pedido-Mesero, Pedido-&lt;br&gt;Boleta, Pedido-DetallePedido y DetallePedido-ItemMenu&lt;br&gt;estaban dibujadas pero ninguna clase tenia el atributo&lt;br&gt;que las materializa como codigo. Se agregaron los cinco&lt;br&gt;atributos de referencia correspondientes." style="text;html=1;align=left;verticalAlign=top;fontStyle=2;fontColor=#98392C;fontSize=11;strokeColor=#98392C;fillColor=#F4E0DC;rounded=1;arcSize=6;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="330" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
