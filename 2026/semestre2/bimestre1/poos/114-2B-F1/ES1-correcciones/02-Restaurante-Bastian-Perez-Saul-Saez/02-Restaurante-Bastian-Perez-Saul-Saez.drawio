        <!-- Titulo -->
        <mxCell id="title" value="Restaurante Sabores del Sur - ES1 TI3V21 114-2B-F1 - Modelo de clases (version corregida)&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot;&gt;Equipo: Bastian Perez y Saul Saez&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="-60" width="1000" height="45" as="geometry" />
        </mxCell>

        <mxCell id="changelog" value="Cambios respecto a la entrega original: (1) se reconectaron tres relaciones que quedaron dibujadas pero sin conectar a ninguna clase (herencia de PlatoCaliente, Pedido-DetallePedido, DetallePedido-ItemMenu); (2) Mesero-Pedido y Pedido-Boleta pasaron de composicion a agregacion (ninguna de las dos es una relacion de pertenencia exclusiva); (3) PlatoCaliente, Bebida y Postre ahora sobrescriben el mismo metodo calcularPrecio() en vez de tres metodos con nombres distintos; (4) se agregaron los atributos de referencia que faltaban en Pedido, DetallePedido e ItemMenu." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontColor=#4C5761;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="-12" width="1680" height="48" as="geometry" />
        </mxCell>

