  <diagram name="Restaurante Sabores del Sur - Modelo corregido" id="restaurante-model">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1080" math="0" shadow="0">
